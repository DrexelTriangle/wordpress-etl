# therectangle.org -- The Triangle's April Fools sibling publication.
#
# A separate WordPress install on the same VM as the legacy Triangle WP
# (10.248.40.141), with its own local database `triangle_rect`. Source the file
# before a run:
#
#     set -a; source profiles/rectangle.env; set +a
#     python3 main.py
#
# Everything here is a deviation from the Triangle defaults; the reasoning for
# each knob is in Utils/SiteProfile.py.

# The Rectangle serves its own uploads and is very much alive, so its URLs must
# NOT be pulled onto the Triangle media tree. Only genuinely-Triangle-hosted
# references still get canonicalized.
LEGACY_MEDIA_HOSTS=thetriangle.org

# Where the Rectangle's own uploads will be served from after the media sync.
# Until that exists, point it at the live site so generated data stays usable.
MEDIA_BASE_URL=https://www.therectangle.org

# 8 of 228 published posts sit under the 100-char floor, and three have empty
# bodies: they are image-only visual gags. Keep them when they have a featured
# image rather than dropping the punchline.
KEEP_SHORT_POSTS_WITH_IMAGE=true

# Ids are a per-run counter, not the WP post id. Set this past the high-water
# mark of the articles already loaded from the Triangle, or the two collide.
# Check before every run -- the Triangle archive grows:
#   SELECT MAX(id) FROM articles;
ID_OFFSET=1000000

# The Rectangle rewrites its section display names for the joke every year
# ("Olds", "Farts & Enter-pain-ment") while the slugs stay put. Record slugs, so
# the CMS taxonomy match survives the next rename.
CATEGORY_TERM_SOURCE=nicename
